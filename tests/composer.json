{
  "name": "extalion/sentry-tests",
  "description": "Test dependencies of the extsentry module: PHPUnit, and the packages PrestaShop provides to the module at runtime, which the module's composer.json replaces.",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "ext-intl": "*",
    "guzzlehttp/promises": "^1.5",
    "guzzlehttp/psr7": "^2.4",
    "phpunit/phpunit": "^9.6",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.0",
    "psr/log": "^1.1",
    "symfony/event-dispatcher": "^4.4",
    "symfony/form": "^4.4",
    "symfony/http-foundation": "^4.4",
    "symfony/http-kernel": "^4.4",
    "symfony/validator": "^4.4"
  },
  "autoload": {
    "psr-4": {
      "Extalion\\Sentry\\": "../src/",
      "Extalion\\Sentry\\Tests\\": ""
    }
  },
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true,
    "policy": {
      "advisories": {
        "ignore": [
          "symfony/form",
          "symfony/http-foundation",
          "symfony/http-kernel",
          "symfony/validator"
        ]
      }
    }
  }
}
